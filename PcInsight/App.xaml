<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="PcInsight.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:views="using:PcInsight.Views"
    xmlns:loc="using:PcInsight.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!-- localization: {loc:Loc key} returns the Babel singleton, so bound labels refresh on switch -->
            <loc:LocExtension x:Key="L" />

            <views:ToneBrushConverter x:Key="ToneBrush" />
            <views:LocalizeConverter x:Key="Loc" />
            <views:BoolToVisibilityConverter x:Key="BoolToVis" />
            <views:CountToVisibilityConverter x:Key="CountToVis" />

            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ToneNormalBrush" Color="#1A1A1A" />
                    <SolidColorBrush x:Key="ToneGoodBrush" Color="#0F7B0F" />
                    <SolidColorBrush x:Key="ToneWarnBrush" Color="#9D5D00" />
                    <SolidColorBrush x:Key="ToneBadBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="ToneMutedBrush" Color="#6E6E6E" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#6E6E6E" />
                    <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#F3F6FC" />
                    <SolidColorBrush x:Key="TableAltRowBrush" Color="#08000000" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ToneNormalBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="ToneGoodBrush" Color="#6CCB5F" />
                    <SolidColorBrush x:Key="ToneWarnBrush" Color="#FCE100" />
                    <SolidColorBrush x:Key="ToneBadBrush" Color="#FF99A4" />
                    <SolidColorBrush x:Key="ToneMutedBrush" Color="#9A9A9A" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#15FFFFFF" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="#A0A0A0" />
                    <SolidColorBrush x:Key="HeroBackgroundBrush" Color="#18FFFFFF" />
                    <SolidColorBrush x:Key="TableAltRowBrush" Color="#0CFFFFFF" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <SolidColorBrush x:Key="ToneNormalBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToneGoodBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToneWarnBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToneBadBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="ToneMutedBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="CardBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="CardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
                    <SolidColorBrush x:Key="SubtleTextBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
                    <SolidColorBrush x:Key="HeroBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
                    <SolidColorBrush x:Key="TableAltRowBrush" Color="{ThemeResource SystemColorWindowColor}" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
